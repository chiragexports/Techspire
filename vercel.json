{
  "version": 2,
  "builds": [
    {
      "src": "techspire_project/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "templates/**",
          "static/**",
          "apps/**",
          "db.sqlite3"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "techspire_project/wsgi.py"
    }
  ]
}
